# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# App — config/ is RUNTIME DATA (API keys, session, undo history, captcha
# recordings, presets). Nothing under it is ever tracked except the
# .gitkeep placeholder (guard: tests/test_repo_hygiene.py, pre_push_check step 0).
config/*
!config/.gitkeep
browser_profile/
logs/
*.log
*.tmp
*.partial_*
db_trash/
saved_media/
media_cache/
*.db
*.sqlite

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Node
node_modules/
coverage.json
.coverage

# Old project research (keep HTML but ignore large files dir)
docs/research/*_files/

# Keep docs
!docs/

# Saved arena.ai pages — personal session dumps (contain account e-mails);
# local research material only. tests/js/test_captcha_saved_page.mjs skips
# when they are absent.
arena webpages/

# D5 mutation testing scratch (mutmut working dir)
mutants/

# Runtime artifacts
__pycache__/
*.py[cod]
config/*.json
